<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chi tiết đơn hàng</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/styles/style.css">
    <style>
        body{
            margin:0;

            min-height:100vh;

            display:flex;
        }

        /* MAIN */
        .main{
            flex: 1;

            background: #f5f6f8;

            display: flex;

            flex-direction: column;

            min-width: 0;
        }
        </style>
</head>
<body>
    <%- include('../partials/sidebar') %>
    <div class="main">
        <%- include('../partials/topbar') %>
        <div class="container py-4">
            <h2>Chi tiết đơn hàng</h2>
            <div class="card p-1 mb-3">
                <div class="card-body">
                    <div class="mb-3">
                <p>
                    <strong>Mã đơn hàng:</strong> <%= rental.id %>
                </p>
                </div>
                <div class="mb-3">
                    <p><strong>Họ và tên: </strong><span class=""><%= rental.customerName %></span></p>
                </div>
                <div class="mb-3">
                    <p><strong>Số điện thoại: </strong><span class=""><%= rental.customerPhone %></span></p>
                </div>
                <div class="mb-3">
                    <p><strong>Email: </strong><span class=""><%= rental.customerEmail %></span></p>
                </div>
                <div class="mb-3"> 
                    <p><strong>Ngày bắt đầu:</strong> <%= rental.startDate ? rental.startDate.toLocaleDateString() : 'N/A' %></p>
                </div>
                <div class="mb-3"> 
                    <p><strong>Ngày kết thúc:</strong> <%= rental.endDate ? rental.endDate.toLocaleDateString() : 'N/A' %></p>
                </div>
                <div class="mb-3">
                    <p><strong>Trạng thái:</strong><span class="badge bg-primary"><%= rental.status %></span></p>
                </div>
                </div>
            </div>
            <div class="table-box ">
                <div class="table-responsive rounded">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Price</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Car rows will be dynamically inserted here -->
                     <!-- ROW -->
                    <tr>


                        <td>

                            <img
                                src="https://images.unsplash.com/photo-1503376780353-7e6692767b70"
                                class="img-fluid rounded"
                            >

                        </td>

                        <td><%= rental.car.name %></td>

                        <td><%= rental.car.pricePerDay %></td>

                    </tr>
                    <!-- ROW -->
                </tbody>
            </table>
            <div class="mb-3">
                <p><strong>Tổng cộng:</strong> <%= rental.totalPrice %> VND</p>
            </div>
         </div>
         </div>
         <div>
            <% if(rental.status ==='pending') { %>
            <form action="/admin/rentals/<%= rental.id %>/confirm" method="POST" style="display:inline-block;">
                <button class="btn btn-primary my-2">
                Duyệt đơn hàng
            </button>
            </form>
            <form action="/admin/rentals/<%= rental.id %>/cancel" method="POST" style="display:inline-block;">
                <button class="btn btn-danger my-2">
                Hủy đơn hàng
            </button>
            </form>
            <% } %>
            <% if(rental.status === 'active')  { %>
            <form action="/admin/rentals/<%= rental.id %>/complete" method="POST" style="display:inline-block;" >
                <button class="btn btn-primary my-2">
                    Hoàn thành đơn hàng
                </button>
            </form>
            <% } %>
            <% if(rental.status === 'completed')  { %>
            
                <a href="/admin/rentals/<%= rental.id %>/payment" class="btn btn-primary my-2">
                    Thanh toán
                </a>
            <% } %>
         </div>
        </div>
        <%- include('../partials/script') %>
</body>
</html>