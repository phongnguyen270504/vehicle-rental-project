<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/styles/style.css">
    <style>
        body{
            margin:0;

            min-height:100vh;

            display:flex;
        }

        /* MAIN */
        .main{
            flex:1;

            background:#f5f6f8;

            display:flex;

            flex-direction:column;
        }
        </style>
</head>
<body>
    <%- include('../partials/sidebar')  %>
    <div class="main">
        <%- include('../partials/topbar') %>
        <div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Thông tin người dùng</h2>

        <a
            href="/admin/users/<%= userDetails.id %>/edit"
            class="btn btn-primary"
        >
            Chỉnh sửa
        </a>
    </div>

    <div class="card">
        <div class="card-body">

            <div class="mb-3">
                <strong>ID:</strong>
                <span><%= userDetails.id %></span>
            </div>

            <div class="mb-3">
                <strong>Họ tên:</strong>
                <span><%= userDetails.fullname %></span>
            </div>

            <div class="mb-3">
                <strong>Email:</strong>
                <span><%= userDetails.email %></span>
            </div>

            <div class="mb-3">
                <strong>Số điện thoại:</strong>
                <span><%= userDetails.phone || 'Chưa cập nhật' %></span>
            </div>

            <div class="mb-3">
                <strong>Vai trò:</strong>
                <span><%= userDetails.role %></span>
            </div>

            <div class="mb-3">
                <strong>Trạng thái:</strong>

                <% if (userDetails.user_status === 'active') { %>
                    <span class="badge bg-success">Active</span>

                <% } else if (userDetails.user_status === 'locked') { %>
                    <span class="badge bg-warning">Locked</span>

                <% } else { %>
                    <span class="badge bg-secondary">Inactive</span>
                <% } %>
            </div>

            <div class="mb-3">
                <strong>Ngày tạo:</strong>
                <span><%= formatDate(userDetails.created_at) %></span>
            </div>

            <div class="mb-3">
                <strong>Cập nhật lần cuối:</strong>
                <span><%= formatDate(userDetails.updated_at) %></span>
            </div>

        </div>
    </div>

    <a href="/admin/users" class="btn btn-secondary mt-3">
        Quay lại
    </a>

</div>
    </div>
</body>
</html>