<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý xe</title>
    <link rel="stylesheet" 
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" 
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" 
    crossorigin="anonymous">
    <link rel="stylesheet" href="/styles/style.css">
<style>

       body{
            margin:0;

            min-height:100vh;

            display:flex;
        }

        
        /* MAIN */
        .main{
            flex:1;

            background:#f5f6f8;

            display:flex;

            flex-direction:column;

            min-width: 0;
        }

        </style>
</head>
<body>
    <%- include('../partials/sidebar')  %>
    <div class="main">
    <%- include('../partials/topbar') %>
        <div class="content">
        <h1>Quản lý xe</h1>
       
        <a href="/admin/cars/create" class="btn btn-primary mb-3">
            + Thêm xe
        </a>
        <!-- Table content will go here -->
         <div class="table-box">
             <div class="my-2">
            <form method="GET" action="/admin/cars" class="row g-3">
                <%- include('../partials/search-bar', { keyword: query.name, search_name: 'name' }) %>
                <div class="col-sm-4">
                    <select class="form-select " name="status">
                        <option value="">Tất cả trạng thái</option>

                        <option value="available"
                            <%= query.status === 'available' ? 'selected' : '' %>>
                            Available
                        </option>

                        <option value="rented"
                            <%= query.status === 'rented' ? 'selected' : '' %>>
                            Rented
                        </option>

                        <option value="maintenance"
                            <%= query.status === 'maintenance' ? 'selected' : '' %>>
                            Maintenance
                        </option>
                    </select>
                </div>
                <div class="col-sm-4">
                    <select class="form-select" name="type">
                        <option value="">Tất cả loại xe</option>

                        <option value="sedan"
                            <%= query.type === 'sedan' ? 'selected' : '' %>>
                            Sedan
                        </option>

                        <option value="suv"
                            <%= query.type === 'suv' ? 'selected' : '' %>>
                            SUV
                        </option>

                        <option value="truck"
                            <%= query.type === 'truck' ? 'selected' : '' %>>
                            Truck
                        </option>
                    </select>
                </div>
                <div class="col-sm-4">
                    <select name="brand" id="brand" class="form-select">
                        <option value="">Tất cả thương hiệu</option>
                        <!-- Brand options will be populated dynamically -->
                         <option value="Toyota" <%= query.brand === 'Toyota' ? 'selected' : '' %>>Toyota</option>
                         <option value="Honda" <%= query.brand === 'Honda' ? 'selected' : '' %>>Honda</option>
                         <option value="Ford" <%= query.brand === 'Ford' ? 'selected' : '' %>>Ford</option>
                    </select>
                </div>
                <div class="col-sm-4">
                    <select class="form-select" name="order">
                        <option value="desc" <%= query.order === "desc" ? "selected" : "" %>>
                            Mới nhất
                        </option>

                        <option value="asc" <%= query.order === "asc" ? "selected" : "" %>>
                            Cũ nhất
                        </option>
                    </select>
                </div>
                <div class="col-sm-8" >
                    <div class="row g-2">
                        <div class="col-6">
                        <input type="number" class="form-control" 
                        name="minPrice" placeholder="Giá tối thiểu" 
                        value="<%= query.minPrice || '' %>">
                    </div>
                    <div class="col-6">
                        <input type="number" class="form-control" 
                        name="maxPrice" placeholder="Giá tối đa" 
                        value="<%= query.maxPrice || '' %>">
                    </div>
                </div>
    
                </div>
            </form>
        </div>
        <div class="table-responsive border rounded">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Car rows will be dynamically inserted here -->
                     <!-- ROW -->
                      <% cars.forEach(car => { %>
                    <tr>

                        <td><%= car.id %></td>

                        <td>

                            <img
                                src="<%= car.image %>"
                                alt="<%= car.name %>"
                                style="width: 100px; height: auto;"
                            >

                        </td>

                        <td><%= car.name %></td>

                        <td><%= car.pricePerDay %></td>

                        <td>
                            <% 
                            if(car.status === 'available') { %>
                                <span class="badge bg-success">
                                    Available
                                </span>
                            <% }
                            if(car.status === 'rented') { %>
                                <span class="badge bg-danger">
                                    Rented
                                </span>
                            <% } 
                            if(car.status === 'maintenance') { %>
                                <span class="badge bg-secondary">
                                    Maintenance
                                </span>
                            <% } %>
                        </td>

                        <td>

                            <a href="/admin/cars/<%= car.id %>/update" class="btn btn-warning btn-sm">
                                Edit
                            </a>
                            <form action="/admin/cars/<%= car.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirmDelete();">
                                <button class="btn btn-danger btn-sm" type="submit">
                                    Delete
                                </button>
                            </form>

                        </td>

                    </tr>
                    <% }) %>

                    <!-- ROW -->
                </tbody>
            </table>
            </div>
         </div>
         <%- include('../partials/pagination', 
         { totalPages, 
            currentPage,
            pagination
        }) %>
    </div>
    </div>
</body>
<script>
    // Add any necessary JavaScript functionality here
    function confirmDelete() {
       return confirm('Are you sure you want to delete this car?');
    }
</script>
</html>