<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tạo đơn hàng</title>
    <link rel="stylesheet" 
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" 
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" 
    crossorigin="anonymous">
    <link rel="stylesheet" href="/styles/style.css">
    <style>
        body{
            margin:0;

            min-height:100vh;

            display:flex;

        }

        
        /* MAIN */
        .main{
            flex:1;

            background:#f5f6f8;


            min-width: 0;
        }

    </style>
</head>
<body>
    <%- include('../partials/sidebar')  %>
    <div class="main">
    
    <%- include('../partials/topbar') %>
        <div class="content">
        <h2 class="mb-4">Tạo đơn hàng</h2>
            <div class="rental-form">
        <form action="/admin/rentals/create" method="GET" class="mb-3">
            <%- include('../partials/search-bar',{ keyword: query.search, search_name: 'name' }) %>
        </form>
        
        <form action="/admin/rentals/create" method="post">
            <input type="hidden" name="page" value="<%= carsResult.currentPage || query?.page || 1 %>">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Thông tin khách hàng</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                    <label class="form-label">Khách hàng đăng ký</label>
                    <select name="user_id" id="user_id" class="form-select">
                        <option value="">-- Khách vãng lai --</option>
                        <% users.forEach(user => {%>
                            <option value="<%= user.id %>"  <%= String(user.id) === String(data.user_id) ? 'selected' : '' %>>
                                <%= user.fullname %> - <%= user.phone || 'Không có SĐT' %> - <%= user.email %>
                            </option>
                            <% }) %>
                        
                    </select>
                   

                    <div class="form-text"> Không chọn khách hàng đăng ký nếu đây là khách vãng lai. </div>
                </div>
                <div class="border rounded p-3">
                    <h6>Thông tin khách vãng lai</h6>

                    <div class="mb-3"> 
                        <label class="form-label">Họ và tên</label> 
                        <input type="text" name="customer_name" class="form-control" 
                        value="<%= data?.customer_name || '' %>">
                         <% if (errors?.customer_name) { %>
                        <div class="text-danger">
                            <%= errors.customer_name %>
                        </div>
                    <% } %>
                    </div>
                    <div class="mb-3"> 
                        <label class="form-label">Số điện thoại</label> 
                        <input type="text" name="customer_phone" class="form-control" 
                        value="<%= data?.customer_phone || '' %>"> 
                        <% if (errors?.customer_phone) { %>
                            <div class="text-danger">
                                <%= errors.customer_phone %>
                            </div>
                        <% } %>
                    </div>
                    <div class="mb-3"> 
                        <label class="form-label">Email</label> 
                        <input type="email" name="customer_email" class="form-control"
                        value="<%= data?.customer_email || '' %>"> 
                         <% if (errors?.customer_email) { %>
                        <div class="text-danger">
                            <%= errors.customer_email %>
                        </div>
                    <% } %>
                    </div>
                </div>
                </div>
                
            </div>
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Chọn xe</h5>

                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <% carsResult.cars.forEach(car => { %>
                            <div class="col-12 col-md-6 col-lg-4">
                                <label class="card h-100">
                                    <div class="card-body">
                                        <div class="form-check mb-2"> 
                                            <input class="form-check-input" type="radio" name="car_id" value="<%= car.id %>"
                                            <%= String(car.id) === String(data?.car_id) ? 'checked' : '' %> > 
                                            <label class="form-check-label fw-bold"> Chọn xe này </label> 
                                        </div>
                                        <% if (car.image) { %> 
                                            <img src="<%= car.image %>" class="img-fluid rounded mb-3" alt="<%= car.name %>">
                                            <% } %>
                                        <h5><%= car.name %></h5> 
                                        <p class="mb-1"> Hãng: <%= car.brand || 'N/A' %> </p> 
                                        
                                        <p class="mb-1"> Loại: <%= car.type || 'N/A' %> </p> 
                                        
                                        <p class="fw-bold mb-0"> <%= Number(car.pricePerDay).toLocaleString('vi-VN') %> đ / ngày </p>
                                    </div>
                                </label>
                            </div>
                            <% }) %>
                            <% if (errors?.car_id) { %>
                                <div class="text-danger">
                                    <%= errors.car_id %>
                                </div>
                            <% } %>
                    </div>
                    <%- include('../partials/pagination', 
            { totalPages: carsResult.totalPages, 
            currentPage: carsResult.currentPage,
            pagination: carsResult.pagination,
            }) %>
                </div>
            </div>
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Thời gian thuê</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">
                                Ngày bắt đầu
                            </label>
                            <input 
                            type="datetime-local" 
                            name="start_date" 
                            id="start_date" class="form-control" 
                            value="<%= data?.start_date || '' %>"
                            >
                            <% if (errors?.start_date) { %>
                                <div class="text-danger">
                                    <%= errors.start_date %>
                                </div>
                            <% } %>
                        </div>
                         <div class="col-md-6 mb-3">
                            <label class="form-label">
                                Ngày kết thúc
                            </label>
                            <input 
                            type="datetime-local" 
                            name="end_date" 
                            id="end_date" class="form-control" 
                            value="<%= data?.end_date || '' %>"
                            >
                            <% if (errors?.end_date) { %>
                                <div class="text-danger">
                                    <%= errors.end_date %>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Buttons --> 
             <div class="d-flex gap-2"> 
                <a href="/admin/rentals" class="btn btn-secondary"> 
                    Hủy 
                </a> 
                <button type="submit" class="btn btn-primary"> 
                    Tạo đơn 
                </button> 
            </div>
        </form>
       </div>
        
    </div>
   <%- include('../partials/script') %>
    <script >
    // Add any necessary JavaScript functionality here
    function confirmDelete() {
       return confirm('Are you sure you want to delete this car?');
    }
</script>
</body>
</html>