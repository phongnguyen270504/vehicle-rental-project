<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" 
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" 
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" 
    crossorigin="anonymous">
    <link rel="stylesheet" href="/styles/style.css">
     <style>
        body{
            margin:0;

            min-height:100vh;

            display:flex;

        }

        
        /* MAIN */
        .main{
            flex:1;

            background:#f5f6f8;


            min-width: 0;
        }

    </style>
</head>
<body>
     <%- include('../partials/sidebar') %>
     <div class="main">
        <%- include('../partials/topbar') %>
        <div class="content">
        <h2 class="my-4">
           Thanh toán đơn thuê
        </h2>
        <div class="card">
            <div class="card-header">
                    <strong>Đơn #<%= rental.id %></strong>
                </div>
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <img src="<%= rental.Car.image %>" alt="<%= rental.Car.name %>" 
                        class="img-fluid rounded main-img" style="max-width: 200px;">
                    </div>
                    <div>
                        <p><strong>Khách hàng:</strong> <%= rental.customerName %></p>
                        <p><strong>Xe:</strong> <%= rental.Car.name %></p>
                        <p class="card-text">Ngày bắt đầu: <%= rental.start_date.toLocaleDateString('vi-VN') %></p>
                        <p class="card-text">Ngày kết thúc: <%= rental.end_date.toLocaleDateString('vi-VN') %></p>
                        
                    </div>
                    <div>
                        <p class="card-text">Tổng tiền: <%= 
                        Number(rental.total_price).toLocaleString('vi-VN',{
                            style: 'currency',
                            currency: 'VND'
                        })
                         %></p>
                    </div>
                </div>
                <div>
                    <form action="/admin/rentals/<%= rental.id %>/payment" method="POST">
                        <div class="mb-3">
                            <label for="paymentMethod" class="form-label">Phương thức thanh toán</label>
                            <select class="form-select" id="paymentMethod" name="paymentMethod" required>
                                <option value="">Chọn phương thức</option>
                                <option value="cash">Tiền mặt</option>
                                <option value="bank_transfer">Chuyển khoản ngân hàng</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary">Thanh toán</button>
                    </form>
                </div>
            </div>
        </div>
     </div>
     <%- include('../partials/script') %>
</body>
</html>