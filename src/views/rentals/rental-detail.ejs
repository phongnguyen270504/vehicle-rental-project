<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

    <link rel="stylesheet" href="/styles/style.css">
    <style>
        body {
            background: #f5f6f8;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        main {
            flex: 1;
        }
    </style>
</head>

<body>
    <header>
        <%- include('../partials/header') %>
    </header>
    <main>
        <div class="container py-4">

            <h2 class="mb-4"><%= title %></h2>

            <div class="card mb-4">

                <div class="card-header">
                    <strong>Đơn #<%= rental.id %></strong>
                </div>

                <div class="card-body">
                    <h5>Thông tin khách hàng</h5>

                     <div class="mb-3"> 
                    <p>
                        <strong>Họ tên:</strong>
                        <%= rental.customerName %>
                    </p>
                    </div>

                     <div class="mb-3"> 
                    <p>
                        <strong>Số điện thoại:</strong>
                        <%= rental.customerPhone %>
                    </p>
                    </div>

                    <div class="mb-3">
                    <p>
                        <strong>Email:</strong>
                        <%= rental.customerEmail %>
                    </p>
                    </div>
                    <div class="mb-3">
                    <p><strong>Trạng thái:</strong><span class="badge bg-primary"><%= rental.status %></span></p>
                    </div>

                    <div class="mb-3">
                    <p>
                        <strong>Ngày bắt đầu:</strong>
                        <%= rental.startDate.toLocaleDateString() %>
                    </p>
                    </div>

                    <div class="mb-3">
                    <p>
                        <strong>Ngày kết thúc:</strong>
                        <%= rental.endDate.toLocaleDateString() %>
                    </p>
                    </div>
                    <% if(rental.admin_id){ %>
                        <div class="mb-3">
                            <p>
                                <strong>Bị huỷ bởi admin</strong>
                            </p>
                        </div>
                    <% } %>
                
                </div>
            </div>
            <div class="table-box table-responsive mb-4">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Price</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Car rows will be dynamically inserted here -->
                     <!-- ROW -->
                    <tr>


                        <td>

                            <img
                                src="<%= rental.car.image %>"
                            >

                        </td>

                        <td><%= rental.car.name %></td>

                        <td><%= rental.car.pricePerDay %></td>

                    </tr>
                    <!-- ROW -->
                </tbody>
            </table>
            <div class="mb-3">
                <p><strong>Tổng cộng:</strong> <%= rental.totalPrice %> VND</p>
            </div>
         </div>
             <% if(rental.status ==='pending') { %>
        <div class="mb-4">
            <form action="/rentals/<%= rental.id %>/cancel" method="POST" style="display:inline-block;">
                <button class="btn btn-danger">
                Hủy đơn hàng
            </button>
            </form>
        </div>
            <% } %>

        </div>
         
    </main>
    <%-include('../partials/footer')  %>
</body>

</html>